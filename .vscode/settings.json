{
  // Use the project's TypeScript (6.x) instead of the editor's bundled one —
  // the tsconfigs and React 19 types assume a current compiler.
  "typescript.tsdk": "frontend/node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ESLint lives in frontend/ with a flat config; without this the extension
  // runs from the repo root and reports phantom errors.
  "eslint.workingDirectories": ["frontend"],
  "eslint.useFlatConfig": true,

  // Root .venv is the uv workspace env (core + backend editable) plus the
  // dev group from the root pyproject (playwright for scripts/) — gives the
  // language server one interpreter that resolves everything.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["core/tests", "backend/tests"]
}
