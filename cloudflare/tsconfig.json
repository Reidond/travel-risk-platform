{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // worker-configuration.d.ts is generated by `wrangler types` (npm run
  // typecheck) and provides Env plus the Workers runtime globals.
  "include": ["src", "worker-configuration.d.ts"]
}
